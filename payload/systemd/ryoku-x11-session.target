[Unit]
Description=RXB X11 session services
Documentation=man:systemd.special(7)
# Started explicitly by the RXB i3 XSession wrapper after validating login1.
# Do not bind to graphical-session.target: X11 display managers do not
# consistently establish that user-manager target. The exact logind session
# ID is carried into the shell and independently verified by its sleep guard.
