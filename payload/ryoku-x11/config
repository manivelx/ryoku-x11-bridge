# RXB i3 session configuration.
# This file is user-owned after first launch. Keep personal overrides in user.conf.
set $mod Mod4
font pango:Sans 10
gaps inner 8
gaps outer 4
default_border pixel 2
default_floating_border pixel 2
floating_modifier $mod
focus_follows_mouse no
workspace_auto_back_and_forth yes
focus_on_window_activation urgent

# Reuse an existing Picom configuration if Picom is installed. Never
# overwrite or generate a compositor configuration.
exec --no-startup-id sh -c 'command -v picom >/dev/null 2>&1 && ! pgrep -x picom >/dev/null 2>&1 && picom --daemon'

# Start the user-session bridge after i3 has created its IPC socket.
exec --no-startup-id ryoku-x11-session-init

# Generated settings are owned by ryoku-wm-i3; user.conf is the safe override.
include ~/.config/ryoku-x11/generated.conf
include ~/.config/ryoku-x11/user.conf

# No default keybindings are installed by RXB yet.
# Upstream Ryoku bind catalogue and i3 translation are still being ported.
# Keep this file free of custom shortcuts; user.conf remains user-owned.
