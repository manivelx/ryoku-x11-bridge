#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${DISPLAY:-} ]]; then
  echo "ryoku-x11-session: DISPLAY is not set; start this from an X11 display manager." >&2
  exit 1
fi
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  echo "ryoku-x11-session: refusing to start i3 inside an existing Wayland session." >&2
  exit 1
fi

# Bind to the exact logind session created by the display manager. Fail closed
# before starting i3 if this is not a normal graphical user login.
if [[ -z ${XDG_SESSION_ID:-} ]]; then
  echo "ryoku-x11-session: XDG_SESSION_ID is missing; cannot bind RXB to logind." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=User --value 2>/dev/null | grep -Fxq "$(id -u)"; then
  echo "ryoku-x11-session: logind session does not belong to this user." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Type --value 2>/dev/null | grep -Fxq x11; then
  echo "ryoku-x11-session: logind does not identify this as an X11 session." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Class --value 2>/dev/null | grep -Fxq user; then
  echo "ryoku-x11-session: logind does not identify this as a graphical user session." >&2
  exit 1
fi

session_id="$XDG_SESSION_ID"
[[ "$session_id" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "ryoku-x11-session: invalid logind session ID." >&2; exit 1; }
runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required for a systemd user session}
lock_file="$runtime_dir/ryoku-x11-session.lock"
if [[ -L "$lock_file" ]]; then echo "ryoku-x11-session: refusing a symlinked session lock." >&2; exit 1; fi
command -v flock >/dev/null 2>&1 || { echo "ryoku-x11-session: flock is required to prevent concurrent RXB sessions." >&2; exit 1; }
if [[ ${1:-} == --rxb-lock-held ]]; then
  shift
else
  if ! (umask 077; flock -n -o "$lock_file" bash "$0" --rxb-lock-held); then
    # The lock is intentionally held for the lifetime of i3. If its wrapper
    # was killed but i3 survived, report the live socket rather than hiding
    # the actual conflict behind the generic per-user lock message.
    shopt -s nullglob
    for active_env in "$runtime_dir"/ryoku-x11-session-*.env; do
      active_name="${active_env##*/}"
      active_id="${active_name#ryoku-x11-session-}"
      active_id="${active_id%.env}"
      [[ "$active_id" != "$session_id" && "$active_id" =~ ^[A-Za-z0-9_.-]+$ ]] || continue
      [[ -f "$active_env" && ! -L "$active_env" && "$(stat -c %h "$active_env" 2>/dev/null || true)" == "1" ]] || continue
      active_socket="$(sed -n 's/^I3SOCK="\([^"]*\)"$/\1/p' "$active_env" | head -n1)"
      if [[ -n "$active_socket" && "$active_socket" == "$runtime_dir"/* && -S "$active_socket" ]]; then
        echo "ryoku-x11-session: previous RXB session $active_id still owns a live i3 socket; refusing a concurrent session." >&2
        exit 1
      fi
    done
    echo "ryoku-x11-session: another RXB graphical session is already active for this user." >&2
    exit 1
  fi
  exit 0
fi
export RYOKU_X11_SESSION_LOCKED=1

# Do not let a stale socket from a previous i3/Sway session steer this one.
unset SWAYSOCK I3SOCK

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Ryoku
export RYOKU_WM=i3

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/ryoku-x11"
ryoku_config_dir="$config_dir/ryoku-config"
quickshell_dir="$ryoku_config_dir/quickshell"
if [[ -L "$config_dir" || -L "$ryoku_config_dir" || -L "$quickshell_dir" ]]; then
  echo "ryoku-x11-session: refusing symlinked RXB config paths." >&2
  exit 1
fi
install -d -m 700 "$config_dir" "$ryoku_config_dir" "$quickshell_dir"
export RYOKU_X11_BRIDGE=1
export RYOKU_CONFIG_HOME="$ryoku_config_dir"
export RYOKU_QUICKSHELL_CONFIG_HOME="$quickshell_dir"

seed_dir=${RYOKU_X11_SEED_DIR:-/usr/share/ryoku/config/ryoku-x11}
for name in config generated.conf user.conf; do
  if [[ ! -e "$config_dir/$name" && -f "$seed_dir/$name" ]]; then
    install -m 600 "$seed_dir/$name" "$config_dir/$name"
  fi
done

for cmd in i3 ryoku-wm-i3 qs ryoku-shell loginctl systemctl xcompmgr flock stat sed head awk seq; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "ryoku-x11-session: required command not found: $cmd" >&2
    exit 1
  }
done

# Recover only stale per-session state. A live i3 socket means the previous
# session may still be active even if its wrapper died, so refuse to overlap it.
stop_stale_compositor() {
  local pid_file="$1" stale_pid stale_start current_start current_comm
  [[ -f "$pid_file" && ! -L "$pid_file" ]] || { rm -f -- "$pid_file"; return 0; }
  [[ "$(stat -c %h "$pid_file")" == "1" ]] || { rm -f -- "$pid_file"; return 0; }
  read -r stale_pid stale_start < "$pid_file" || { rm -f -- "$pid_file"; return 0; }
  if [[ "$stale_pid" =~ ^[0-9]+$ && "$stale_start" =~ ^[0-9]+$ &&
        -r "/proc/$stale_pid/stat" && -r "/proc/$stale_pid/comm" ]]; then
    current_comm="$(cat "/proc/$stale_pid/comm" 2>/dev/null || true)"
    current_start="$(awk '{print $22}' "/proc/$stale_pid/stat" 2>/dev/null || true)"
    if [[ "$current_comm" == "xcompmgr" && "$current_start" == "$stale_start" ]]; then
      kill -TERM "$stale_pid" 2>/dev/null || true
      for _ in $(seq 1 20); do
        [[ -r "/proc/$stale_pid/stat" ]] || break
        current_comm="$(cat "/proc/$stale_pid/comm" 2>/dev/null || true)"
        current_start="$(awk '{print $22}' "/proc/$stale_pid/stat" 2>/dev/null || true)"
        current_state="$(awk '{print $3}' "/proc/$stale_pid/stat" 2>/dev/null || true)"
        [[ "$current_comm" != "xcompmgr" || "$current_start" != "$stale_start" || "$current_state" == "Z" ]] && break
        sleep 0.05
      done
      current_comm="$(cat "/proc/$stale_pid/comm" 2>/dev/null || true)"
      current_start="$(awk '{print $22}' "/proc/$stale_pid/stat" 2>/dev/null || true)"
      current_state="$(awk '{print $3}' "/proc/$stale_pid/stat" 2>/dev/null || true)"
      if [[ "$current_comm" == "xcompmgr" && "$current_start" == "$stale_start" && "$current_state" != "Z" ]]; then
        kill -KILL "$stale_pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f -- "$pid_file"
}

recover_stale_sessions() {
  local stale_env stale_name stale_id stale_socket unit stale_pid_file
  shopt -s nullglob
  for stale_env in "$runtime_dir"/ryoku-x11-session-*.env; do
    stale_name="${stale_env##*/}"
    stale_id="${stale_name#ryoku-x11-session-}"
    stale_id="${stale_id%.env}"
    [[ "$stale_id" == "$session_id" ]] && continue
    [[ "$stale_id" =~ ^[A-Za-z0-9_.-]+$ ]] || {
      echo "ryoku-x11-session: refusing an invalid stale session identifier." >&2
      return 1
    }
    [[ -f "$stale_env" && ! -L "$stale_env" ]] || {
      echo "ryoku-x11-session: refusing an unsafe stale EnvironmentFile: $stale_env" >&2
      return 1
    }
    [[ "$(stat -c %h "$stale_env")" == "1" ]] || {
      echo "ryoku-x11-session: refusing a hard-linked stale EnvironmentFile: $stale_env" >&2
      return 1
    }
    stale_socket="$(sed -n 's/^I3SOCK="\([^"]*\)"$/\1/p' "$stale_env" | head -n1)"
    [[ -n "$stale_socket" && "$stale_socket" == "$runtime_dir"/* ]] || {
      echo "ryoku-x11-session: refusing a stale EnvironmentFile without a safe i3 socket path." >&2
      return 1
    }
    if [[ -S "$stale_socket" ]]; then
      echo "ryoku-x11-session: previous RXB session $stale_id still owns a live i3 socket; refusing a concurrent session." >&2
      return 1
    fi
    for unit in "ryoku-shell-x11@$stale_id.service" "ryogami-x11@$stale_id.service"; do
      if systemctl --user is-active --quiet "$unit"; then
        systemctl --user stop "$unit" >/dev/null 2>&1 || {
          echo "ryoku-x11-session: failed to stop stale service instance $unit." >&2
          return 1
        }
      fi
    done
    stale_pid_file="$runtime_dir/ryoku-x11-compositor-$stale_id.pid"
    stop_stale_compositor "$stale_pid_file"
    rm -f -- "$stale_env" "$runtime_dir/ryoku-x11-i3-$stale_id.conf" "$runtime_dir/ryoku-x11-session-$stale_id.pid"
  done
  for stale_pid_file in "$runtime_dir"/ryoku-x11-compositor-*.pid; do
    stale_name="${stale_pid_file##*/}"
    stale_id="${stale_name#ryoku-x11-compositor-}"
    stale_id="${stale_id%.pid}"
    [[ "$stale_id" == "$session_id" ]] && continue
    [[ -e "$runtime_dir/ryoku-x11-session-$stale_id.env" ]] && continue
    stop_stale_compositor "$stale_pid_file"
  done
  for stale_pid_file in "$runtime_dir"/ryoku-x11-session-*.pid; do
    stale_name="${stale_pid_file##*/}"
    stale_id="${stale_name#ryoku-x11-session-}"
    stale_id="${stale_id%.pid}"
    [[ "$stale_id" == "$session_id" ]] && continue
    [[ -e "$runtime_dir/ryoku-x11-session-$stale_id.env" ]] || rm -f -- "$stale_pid_file"
  done
  shopt -u nullglob
}

recover_stale_sessions || exit 1

# Generate Ryoku's keybinding catalogue before i3 reads the config.
# This writes only RXB's generated.conf; user.conf remains user-owned.
ryoku-wm-i3 apply "$RYOKU_CONFIG_HOME/ryoku/desktop.json" >/dev/null

env_file="$runtime_dir/ryoku-x11-session-$session_id.env"
session_pid_file="$runtime_dir/ryoku-x11-session-$session_id.pid"
compositor_pid_file="$runtime_dir/ryoku-x11-compositor-$session_id.pid"
compositor_pid=""
runtime_config=""
cleanup() {
  local status=$?
  trap - EXIT
  systemctl --user stop ryoku-x11-session.target >/dev/null 2>&1 || true
  if [[ -n "$compositor_pid" ]]; then
    kill -TERM "$compositor_pid" 2>/dev/null || true
    wait "$compositor_pid" 2>/dev/null || true
  fi
  rm -f "$env_file" "$session_pid_file" "$compositor_pid_file" || true
  [[ -z "$runtime_config" ]] || rm -f "$runtime_config" || true
  exit "$status"
}
trap cleanup EXIT
if [[ -L "$session_pid_file" ]]; then
  echo "ryoku-x11-session: refusing a symlinked session PID file." >&2
  exit 1
fi
rm -f -- "$session_pid_file" "$compositor_pid_file"
session_wrapper_pid="$BASHPID"
(umask 077; printf '%s\n' "$session_wrapper_pid" > "$session_pid_file")

# RXB uses the XRender-only xcompmgr path, never Picom's GLX/NVIDIA backend.
# This compositor belongs only to this i3 session and is stopped on exit.
# If another compositor already owns the X selection or xcompmgr cannot start,
# continue without compositing rather than disturbing another desktop.
xcompmgr -n >"$runtime_dir/ryoku-x11-compositor-$session_id.log" 2>&1 &
compositor_pid=$!
for _ in $(seq 1 20); do
  [[ -r "/proc/$compositor_pid/comm" && "$(cat "/proc/$compositor_pid/comm")" == "xcompmgr" ]] && break
  sleep 0.01
done
compositor_start="$(awk '{print $22}' "/proc/$compositor_pid/stat" 2>/dev/null || true)"
if [[ "$compositor_start" =~ ^[0-9]+$ ]]; then
  (umask 077; printf '%s %s\n' "$compositor_pid" "$compositor_start" > "$compositor_pid_file")
fi
sleep 0.2
if ! kill -0 "$compositor_pid" 2>/dev/null; then
  wait "$compositor_pid" 2>/dev/null || true
  compositor_pid=""
  rm -f -- "$compositor_pid_file"
  echo "ryoku-x11-session: xcompmgr unavailable; continuing without compositing" >&2
fi

# Resolve only the two RXB-owned includes into a session-only runtime copy.
runtime_config="$runtime_dir/ryoku-x11-i3-$session_id.conf"
if [[ -L "$runtime_config" ]]; then
  echo "ryoku-x11-session: refusing a symlinked runtime i3 config." >&2
  exit 1
fi
rm -f -- "$runtime_config"
(umask 077; set -o noclobber; : > "$runtime_config")
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    "include ~/.config/ryoku-x11/generated.conf")
      printf 'include "%s/generated.conf"\n' "$config_dir"
      ;;
    "include ~/.config/ryoku-x11/user.conf")
      printf 'include "%s/user.conf"\n' "$config_dir"
      ;;
    *)
      printf '%s\n' "$line"
      ;;
  esac
done < "$config_dir/config" > "$runtime_config"
chmod 600 "$runtime_config"
i3 -c "$runtime_config"
