#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${DISPLAY:-} ]]; then
  echo "ryoku-x11-session: DISPLAY is not set; start this from an X11 display manager." >&2
  exit 1
fi
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  echo "ryoku-x11-session: refusing to start i3 inside an existing Wayland session." >&2
  exit 1
fi

# Bind to the exact logind session created by the display manager. Fail closed
# before starting i3 if this is not a normal graphical user login.
if [[ -z ${XDG_SESSION_ID:-} ]]; then
  echo "ryoku-x11-session: XDG_SESSION_ID is missing; cannot bind RXB to logind." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=User --value 2>/dev/null | grep -Fxq "$(id -u)"; then
  echo "ryoku-x11-session: logind session does not belong to this user." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Type --value 2>/dev/null | grep -Fxq x11; then
  echo "ryoku-x11-session: logind does not identify this as an X11 session." >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Class --value 2>/dev/null | grep -Exq 'user|user-early'; then
  echo "ryoku-x11-session: logind does not identify this as a graphical user session." >&2
  exit 1
fi

# Do not let a stale socket from a previous i3/Sway session steer this one.
unset SWAYSOCK I3SOCK

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Ryoku
export RYOKU_WM=i3

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/ryoku-x11"
ryoku_config_dir="$config_dir/ryoku-config"
quickshell_dir="$ryoku_config_dir/quickshell"
if [[ -L "$config_dir" || -L "$ryoku_config_dir" || -L "$quickshell_dir" ]]; then
  echo "ryoku-x11-session: refusing symlinked RXB config paths." >&2
  exit 1
fi
install -d -m 700 "$config_dir" "$ryoku_config_dir" "$quickshell_dir"
export RYOKU_X11_BRIDGE=1
export RYOKU_CONFIG_HOME="$ryoku_config_dir"
export RYOKU_QUICKSHELL_CONFIG_HOME="$quickshell_dir"

seed_dir=${RYOKU_X11_SEED_DIR:-/usr/share/ryoku/config/ryoku-x11}
for name in config generated.conf user.conf; do
  if [[ ! -e "$config_dir/$name" && -f "$seed_dir/$name" ]]; then
    install -m 600 "$seed_dir/$name" "$config_dir/$name"
  fi
done

for cmd in i3 ryoku-wm-i3 qs ryoku-shell loginctl; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "ryoku-x11-session: required command not found: $cmd" >&2
    exit 1
  }
done

# Generate Ryoku's keybinding catalogue before i3 reads the config.
# This writes only RXB's generated.conf; user.conf remains user-owned.
ryoku-wm-i3 apply "$RYOKU_CONFIG_HOME/ryoku/desktop.json" >/dev/null

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required for a systemd user session}
env_file="$runtime_dir/ryoku-x11-session.env"
cleanup() {
  local status=$?
  trap - EXIT
  systemctl --user stop ryoku-x11-session.target >/dev/null 2>&1 || true
  rm -f "$env_file" "$runtime_config" || true
  exit "$status"
}
trap cleanup EXIT

# Resolve only the two RXB-owned includes into a session-only runtime copy.
runtime_config="$runtime_dir/ryoku-x11-i3.conf"
if [[ -L "$runtime_config" ]]; then
  echo "ryoku-x11-session: refusing a symlinked runtime i3 config." >&2
  exit 1
fi
rm -f -- "$runtime_config"
(umask 077; set -o noclobber; : > "$runtime_config")
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    "include ~/.config/ryoku-x11/generated.conf")
      printf 'include "%s/generated.conf"\n' "$config_dir"
      ;;
    "include ~/.config/ryoku-x11/user.conf")
      printf 'include "%s/user.conf"\n' "$config_dir"
      ;;
    *)
      printf '%s\n' "$line"
      ;;
  esac
done < "$config_dir/config" > "$runtime_config"
chmod 600 "$runtime_config"
i3 -c "$runtime_config"
