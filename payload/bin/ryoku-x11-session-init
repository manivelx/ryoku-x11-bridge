#!/usr/bin/env bash
set -euo pipefail

[[ -n ${DISPLAY:-} ]] || exit 1
[[ -z ${WAYLAND_DISPLAY:-} ]] || exit 1

# Revalidate exact login1 session prior to creating RXB services.
if [[ -z ${XDG_SESSION_ID:-} ]]; then
  echo "ryoku-x11-session-init: XDG_SESSION_ID is missing; refusing an unbound session" >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=User --value 2>/dev/null | grep -Fxq "$(id -u)"; then
  echo "ryoku-x11-session-init: XDG_SESSION_ID does not belong to this user" >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Type --value 2>/dev/null | grep -Fxq x11; then
  echo "ryoku-x11-session-init: logind does not identify this session as X11" >&2
  exit 1
fi
if ! loginctl show-session "$XDG_SESSION_ID" --property=Class --value 2>/dev/null | grep -Exq 'user|user-early'; then
  echo "ryoku-x11-session-init: logind session is not a graphical user session" >&2
  exit 1
fi

# Never trust an inherited I3SOCK: it may belong to a previous i3/Sway session.
socket=""
for _ in $(seq 1 50); do
  if [[ -z "$socket" || ! -S "$socket" ]]; then
    socket="$(env -u SWAYSOCK -u I3SOCK i3 --get-socketpath 2>/dev/null || true)"
  fi
  if [[ -n "$socket" && -S "$socket" ]]; then break; fi
  sleep 0.1
done
[[ -n "$socket" && -S "$socket" ]] || {
  echo "ryoku-x11-session-init: i3 IPC socket did not become ready" >&2
  exit 1
}

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Ryoku
export RYOKU_WM=i3
export I3SOCK="$socket"

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/ryoku-x11"
ryoku_config_dir="$config_dir/ryoku-config"
quickshell_dir="$ryoku_config_dir/quickshell"
if [[ -L "$config_dir" || -L "$ryoku_config_dir" || -L "$quickshell_dir" ]]; then
  echo "ryoku-x11-session-init: refusing symlinked RXB config paths" >&2
  exit 1
fi
install -d -m 700 "$config_dir" "$ryoku_config_dir" "$quickshell_dir"
export RYOKU_X11_BRIDGE=1
export RYOKU_CONFIG_HOME="$ryoku_config_dir"
export RYOKU_QUICKSHELL_CONFIG_HOME="$quickshell_dir"

ryoku materialize || {
  echo "ryoku-x11-session-init: failed to materialize the packaged Ryoku shell config" >&2
  exit 1
}

# Keep X11 session variables local to the Ryoku shell unit; never import them
# into the shared systemd user manager where they would leak into BSPWM.
runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required for a systemd user session}
env_file="$runtime_dir/ryoku-x11-session.env"
if [[ -L "$env_file" ]]; then
  echo "ryoku-x11-session-init: refusing a symlinked session EnvironmentFile" >&2
  exit 1
fi
rm -f -- "$env_file"
(umask 077; : > "$env_file")
chmod 600 "$env_file"
write_env() {
  local key="$1" value="$2"
  if [[ "$value" == *$'\n'* || "$value" == *'"'* || "$value" == *\\* ]]; then
    echo "ryoku-x11-session-init: unsafe value for $key in systemd EnvironmentFile" >&2
    exit 1
  fi
  printf '%s="%s"\n' "$key" "$value"
}
umask 077
{
  write_env DISPLAY "$DISPLAY"
  write_env XDG_SESSION_ID "$XDG_SESSION_ID"
  write_env XDG_SESSION_TYPE x11
  write_env XDG_CURRENT_DESKTOP Ryoku
  write_env RYOKU_WM i3
  write_env I3SOCK "$socket"
  write_env RYOKU_X11_BRIDGE "$RYOKU_X11_BRIDGE"
  write_env RYOKU_CONFIG_HOME "$RYOKU_CONFIG_HOME"
  write_env RYOKU_QUICKSHELL_CONFIG_HOME "$RYOKU_QUICKSHELL_CONFIG_HOME"
  [[ -z ${XDG_CONFIG_HOME:-} ]] || write_env XDG_CONFIG_HOME "$XDG_CONFIG_HOME"
  [[ -z ${XDG_DATA_HOME:-} ]] || write_env XDG_DATA_HOME "$XDG_DATA_HOME"
  [[ -z ${XDG_CACHE_HOME:-} ]] || write_env XDG_CACHE_HOME "$XDG_CACHE_HOME"
  [[ -z ${XDG_STATE_HOME:-} ]] || write_env XDG_STATE_HOME "$XDG_STATE_HOME"
  [[ -z ${XAUTHORITY:-} ]] || write_env XAUTHORITY "$XAUTHORITY"
} > "$env_file"

systemctl --user daemon-reload
systemctl --user start ryoku-x11-session.target
