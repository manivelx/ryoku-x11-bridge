#!/usr/bin/env bash
set -euo pipefail

[[ -n ${DISPLAY:-} ]] || exit 1
[[ -z ${WAYLAND_DISPLAY:-} ]] || exit 1

socket="${I3SOCK:-}"
for _ in $(seq 1 50); do
  if [[ -z "$socket" || ! -S "$socket" ]]; then
    # i3 and Sway share the IPC protocol; explicitly ignore SWAYSOCK so this
    # X11 session cannot accidentally bootstrap against a Sway instance.
    socket="$(env -u SWAYSOCK -u I3SOCK i3 --get-socketpath 2>/dev/null || true)"
  fi
  if [[ -n "$socket" && -S "$socket" ]]; then
    break
  fi
  sleep 0.1
done
[[ -n "$socket" && -S "$socket" ]] || {
  echo "ryoku-x11-session-init: i3 IPC socket did not become ready" >&2
  exit 1
}

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=Ryoku
export RYOKU_WM=i3
export I3SOCK="$socket"

env_names=(DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP RYOKU_WM I3SOCK)
[[ -n ${XAUTHORITY:-} ]] && env_names+=(XAUTHORITY)
ryoku materialize || {
  echo "ryoku-x11-session-init: failed to materialize the packaged Ryoku shell config" >&2
  exit 1
}
systemctl --user unset-environment WAYLAND_DISPLAY
systemctl --user import-environment "${env_names[@]}"
systemctl --user daemon-reload
# The package links ryoku-shell.service into ryoku-session.target.wants.
# Starting the RXB target is sufficient and avoids persistent user-level enablement.
systemctl --user start ryoku-session.target
