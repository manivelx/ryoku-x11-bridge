#!/usr/bin/env bash
set -euo pipefail

# Trusted locker directory. Lockers are resolved ONLY from this absolute path,
# never from $PATH: a user-writable PATH entry must not be able to substitute a
# fake "xsecurelock" or "i3lock" that holds the lock file without locking the
# screen. The Go daemon (rxbTrustedLockerDir) accepts the same directory only.
locker_dir=/usr/bin

# An RXB X11 session is identified by RYOKU_WM/XDG_SESSION_TYPE as well as by an
# empty WAYLAND_DISPLAY, so a stray WAYLAND_DISPLAY can never route an X11
# session into the Wayland qylock path.
x11_session=0
if [[ -z ${WAYLAND_DISPLAY:-} || ${RYOKU_WM:-} == i3 || ${XDG_SESSION_TYPE:-} == x11 ]]; then
  x11_session=1
fi

# Preserve the upstream Wayland qylock path. On Xorg, use a real PAM-backed
# locker; never substitute a fullscreen Quickshell window for an OS lock.
if [[ $x11_session == 0 ]]; then
  exec ryoku-qylock-lock
fi
if [[ -z ${DISPLAY:-} ]]; then
  echo "ryoku-x11-lock: no active X11 display; refusing to fake a lock screen" >&2
  exit 69
fi
runtime=${XDG_RUNTIME_DIR:-}
if [[ -z "$runtime" || ! -d "$runtime" || ! -O "$runtime" ]]; then
  echo "ryoku-x11-lock: a user-owned XDG_RUNTIME_DIR is required" >&2
  exit 69
fi

# "host:D.S" and "host:D" name the same X display; ignore the screen number so
# both spellings share one lock and one locker.
normalize_display() {
  local d=$1
  if [[ $d == *:*.* ]]; then d=${d%.*}; fi
  printf '%s' "$d"
}

umask 077
lock_dir="$runtime/ryoku-x11-lock"
install -d -m700 "$lock_dir"
display=$(normalize_display "$DISPLAY")
display_key=${display//[^A-Za-z0-9_.-]/_}
lock_file="$lock_dir/$display_key.lock"
state_file="$lock_dir/$display_key.state"

# --- identity of the running locker -----------------------------------------
# XSecureLock marks itself non-dumpable (prctl PR_SET_DUMPABLE 0), which makes
# /proc/PID/{exe,environ,fd} unreadable even to the same user. Scanning /proc
# for a locker by executable or environment therefore cannot work. Instead the
# wrapper that starts the locker records "<pid> <starttime>" for this display.
# The pair is checked against /proc/PID/stat, so a reused PID is rejected.
proc_starttime() { # pid -> field 22 of /proc/PID/stat (state in $proc_state)
  local stat rest
  stat=$(<"/proc/$1/stat") || return 1
  rest=${stat##*) } # strip "pid (comm) " even when comm contains spaces or ")"
  # shellcheck disable=SC2086
  set -- $rest
  proc_state=$1
  printf '%s' "${20}"
}

verified_locker() {
  local pid start current key value uid comm exe
  [[ -r $state_file ]] || return 1
  read -r pid start <"$state_file" || return 1
  [[ $pid =~ ^[0-9]+$ && $start =~ ^[0-9]+$ ]] || return 1
  proc_state=
  current=$(proc_starttime "$pid") || return 1
  [[ $current == "$start" ]] || return 1
  [[ $proc_state != Z && $proc_state != X ]] || return 1
  uid=
  while read -r key value _; do
    if [[ $key == Uid: ]]; then uid=$value; break; fi
  done <"/proc/$pid/status" || return 1
  [[ $uid == "$(id -u)" ]] || return 1
  comm=$(<"/proc/$pid/comm") || return 1
  case "$comm" in xsecurelock | i3lock) ;; *) return 1 ;; esac
  # Readable only for dumpable processes (i3lock); when it is readable it must
  # be a trusted locker binary, never a renamed or PATH-installed copy.
  if exe=$(readlink "/proc/$pid/exe" 2>/dev/null); then
    exe=${exe% (deleted)}
    case "$exe" in "$locker_dir/xsecurelock" | "$locker_dir/i3lock") ;; *) return 1 ;; esac
  fi
  return 0
}

exec 9>"$lock_file"

# The lock is held through file descriptor 9, which the locker inherits, so it
# lives exactly as long as the locker (even if this wrapper is killed).
# A repeated request is idempotent only when a verified locker is really
# running. If the lock is held but no verified locker is active (a wrapper that
# is still starting its locker, or a stale holder), wait briefly and then fail
# rather than report a locked session that is not locked.
acquired=0
for _ in $(seq 1 20); do
  if flock -n 9; then
    acquired=1
    break
  fi
  if verified_locker; then exit 0; fi
  sleep 0.1
done
if [[ $acquired != 1 ]]; then
  echo "ryoku-x11-lock: lock for display $DISPLAY is held but no verified locker is running; refusing to report the session as locked" >&2
  exit 75
fi
rm -f -- "$state_file"

locker=
if [[ -x "$locker_dir/xsecurelock" ]]; then
  locker=("$locker_dir/xsecurelock")
elif [[ -x "$locker_dir/i3lock" ]]; then
  locker=("$locker_dir/i3lock" --nofork --color=000000)
else
  echo "ryoku-x11-lock: install xsecurelock or i3lock in $locker_dir; refusing to fake a lock screen" >&2
  exit 127
fi

sanitize_xsecurelock_environment() {
  local pam_service_override="${XSECURELOCK_PAM_SERVICE:-}"
  local allow_test_service=0 marker_uid="" marker_mode=""
  local pam_file="" pam_uid="" pam_mode="" variable
  local auth_module=/usr/lib/xsecurelock/auth_x11
  local authproto_module=/usr/lib/xsecurelock/authproto_pam

  # XSecureLock exposes environment switches for auth modules, saver helpers,
  # key-triggered commands and display coverage. Do not inherit those choices
  # from a user's shell. Always force the X11 PAM authentication path.
  if [[ ${RXB_PAM_TEST_DISPOSABLE:-} == 1 && -f /.dockerenv \
      && -f /run/rxb-pam-test-disposable && ! -L /run/rxb-pam-test-disposable ]]; then
    marker_uid="$(/usr/bin/stat -c '%u' -- /run/rxb-pam-test-disposable 2>/dev/null || true)"
    marker_mode="$(/usr/bin/stat -c '%a' -- /run/rxb-pam-test-disposable 2>/dev/null || true)"
    if [[ "$marker_uid" == 0 && "$marker_mode" =~ ^[0-7]{3,4}$ ]] \
        && (( (8#$marker_mode & 077) == 0 )); then
      allow_test_service=1
    fi
  fi

  for variable in ${!XSECURELOCK_@}; do unset "$variable"; done
  unset RXB_PAM_TEST_DISPOSABLE
  [[ -x "$auth_module" && -x "$authproto_module" ]] || {
    echo "ryoku-x11-lock: XSecureLock PAM helpers are missing or not executable in /usr/lib/xsecurelock; refusing to start an unverified locker" >&2
    exit 127
  }
  export XSECURELOCK_AUTH="$auth_module"
  export XSECURELOCK_AUTHPROTO="$authproto_module"

  # The isolated Xephyr acceptance test needs to select its temporary PAM
  # stacks. Permit that override only with the root-owned marker created by
  # the disposable-container test harness; normal sessions always use the
  # XSecureLock build's compiled-in PAM service.
  if (( allow_test_service )) && [[ "$pam_service_override" =~ ^[A-Za-z0-9_.-]{1,64}$ ]]; then
    pam_file="/etc/pam.d/$pam_service_override"
    if [[ -f "$pam_file" && ! -L "$pam_file" ]]; then
      pam_uid="$(/usr/bin/stat -c '%u' -- "$pam_file" 2>/dev/null || true)"
      pam_mode="$(/usr/bin/stat -c '%a' -- "$pam_file" 2>/dev/null || true)"
      if [[ "$pam_uid" == 0 && "$pam_mode" =~ ^[0-7]{3,4}$ ]] \
          && (( (8#$pam_mode & 022) == 0 )); then
        export XSECURELOCK_PAM_SERVICE="$pam_service_override"
      fi
    fi
  fi
}

if [[ "${locker[0]}" == "$locker_dir/xsecurelock" ]]; then
  sanitize_xsecurelock_environment
fi

# Run the locker as a child (explicitly keeping stdin) so its pid and start
# time can be recorded, then wait for it and propagate its status.
"${locker[@]}" <&0 &
locker_pid=$!
record_locker() {
  local start state_tmp
  proc_state=
  start=$(proc_starttime "$locker_pid" 2>/dev/null) || return 0 # already gone
  state_tmp="$state_file.$$"
  printf '%s %s\n' "$locker_pid" "$start" >"$state_tmp"
  mv -f -- "$state_tmp" "$state_file"
}
record_locker
forget_locker() {
  # Only drop the record once the locker is really gone; a signalled wrapper
  # must leave a still-running locker verifiable.
  if ! kill -0 "$locker_pid" 2>/dev/null; then rm -f -- "$state_file"; fi
}
trap forget_locker EXIT

status=0
wait "$locker_pid" || status=$?
exit "$status"
