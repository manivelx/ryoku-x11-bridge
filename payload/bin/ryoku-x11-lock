#!/usr/bin/env bash
set -euo pipefail

# Prefer XSecureLock when installed. The i3lock fallback is a real PAM-backed
# locker, not a Quickshell fullscreen window. If the selected locker fails,
# propagate the failure rather than silently continuing an unlocked session.
if command -v xsecurelock >/dev/null 2>&1; then
  exec xsecurelock
fi

if command -v i3lock >/dev/null 2>&1; then
  exec i3lock --nofork --color=000000
fi

echo "ryoku-x11-lock: install xsecurelock or i3lock; refusing to fake a lock screen" >&2
exit 127
