# RXB i3 provider package. The base ryoku-desktop package depends on the
# ryoku-desktop-compositor virtual; this package provides it without depending
# back on the umbrella package (which would create a dependency cycle).
pkgname=ryoku-desktop-i3
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Ryoku desktop X11/i3 session and RXB window-manager provider"
arch=('x86_64')
url="https://github.com/manivelx/ryoku-x11-bridge"
license=('GPL-3.0-or-later')
makedepends=('go')
depends=(
  "ryoku-shell=$epoch:$pkgver"
  'i3-wm'
  'xorg-server'
  'quickshell'
)
optdepends=(
  'xsecurelock: PAM-backed X11 screen locker for the Ryoku lock action'
  'picom: X11 compositor for transparency and effects'
  'maim: X11 screenshot capture backend'
  'xclip: X11 clipboard ownership and clipboard history'
  'slop: X11 region selection for OCR and QR capture'
  'xorg-xrandr: output geometry lookup for X11 screenshots'
  'xterm: fallback terminal for the starter i3 keybinding'
)
provides=('ryoku-desktop-compositor')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" RYOKU_BUILD_DIR="$srcdir" "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" RYOKU_BUILD_DIR="$srcdir" "$startdir/payload.sh" install "$pkgdir" systemd
}
