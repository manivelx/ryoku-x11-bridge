# RXB i3 compositor variant. Like the upstream Hyprland/niri variants, it
# depends on the Ryoku base and provides the compositor virtual required by it.
pkgname=ryoku-desktop-i3
pkgver=${RYOKU_PKGVER:?set RYOKU_PKGVER to the pinned upstream Ryoku VERSION}
pkgrel=1
epoch=1
pkgdesc="Ryoku desktop X11/i3 session and RXB window-manager provider"
arch=('x86_64')
url="https://github.com/manivelx/ryoku-x11-bridge"
license=('GPL-3.0-only')
makedepends=('go')
# The upstream base and wallpaper daemon have independent pkgver/pkgrel
# values (for example ryoku-desktop 0.1.0 and ryogami 0.2.0). RXB's variant
# pkgver follows the pinned source VERSION, so version-pin neither dependency.
depends=(
  'ryoku-desktop'
  'ryogami'
  'i3-wm'
  'i3lock'
  'libnotify'
  'util-linux'
  'xdotool'
  'xorg-server'
  'xcompmgr'
  'quickshell>=0.3.2'
  'maim'
  'xclip'
  'slop'
  'xorg-xrandr'
)
optdepends=(
  'xsecurelock: PAM-backed X11 screen locker for the Ryoku lock action'
  'xterm: fallback terminal for the starter i3 keybinding'
)
provides=('ryoku-desktop-compositor')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" RYOKU_BUILD_DIR="$srcdir" bash "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" RYOKU_BUILD_DIR="$srcdir" bash "$startdir/payload.sh" install "$pkgdir" systemd
}
