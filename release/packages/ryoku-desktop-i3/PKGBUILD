# RXB: X11/i3 integration package for the original Ryoku desktop.
pkgname=ryoku-desktop-i3
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Ryoku desktop X11 session using i3, Quickshell and the RXB provider"
arch=('x86_64')
url="https://github.com/manivelx/ryoku-x11-bridge"
license=('GPL-3.0-or-later')
makedepends=('go')
depends=(
  "ryoku-desktop=$epoch:$pkgver"
  'i3-wm'
  'quickshell'
)
optdepends=(
  'xsecurelock: PAM-backed X11 screen locker used by ryoku-shell lock'
  'picom: X11 compositor for transparency and effects'
  'xterm: fallback terminal for the starter i3 keybinding'
)
provides=('ryoku-desktop-compositor')
source=()
_repo="$startdir/../../.."

build() {
  mkdir -p "$srcdir"
  cd "$_repo/cmd/ryoku-wm-i3"
  go build -trimpath -o "$srcdir/ryoku-wm-i3" .
}

package() {
  install -Dm755 "$srcdir/ryoku-wm-i3" "$pkgdir/usr/bin/ryoku-wm-i3"
  install -Dm755 "$_repo/payload/bin/ryoku-x11-session" "$pkgdir/usr/bin/ryoku-x11-session"
  install -Dm755 "$_repo/payload/bin/ryoku-x11-session-init" "$pkgdir/usr/bin/ryoku-x11-session-init"

  install -d "$pkgdir/usr/share/ryoku/config/ryoku-x11"
  install -m644 "$_repo/payload/ryoku-x11/config" "$pkgdir/usr/share/ryoku/config/ryoku-x11/config"
  install -m644 "$_repo/payload/ryoku-x11/generated.conf" "$pkgdir/usr/share/ryoku/config/ryoku-x11/generated.conf"
  install -m644 "$_repo/payload/ryoku-x11/user.conf" "$pkgdir/usr/share/ryoku/config/ryoku-x11/user.conf"

  install -Dm644 "$_repo/payload/systemd/ryoku-shell.service.d/10-rxb-x11.conf" \
    "$pkgdir/usr/lib/systemd/user/ryoku-shell.service.d/10-rxb-x11.conf"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/xsessions/ryoku-x11.desktop" <<'EOF'
[Desktop Entry]
Name=Ryoku (X11 / i3)
Comment=Ryoku desktop on Xorg with i3
TryExec=i3
Exec=ryoku-x11-session
Type=Application
DesktopNames=Ryoku;
EOF
}
